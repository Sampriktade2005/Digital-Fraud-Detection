*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/
*.egg

# === Jupyter ===
.ipynb_checkpoints/
*.ipynb_checkpoints

# === Models (large binaries) ===
models/*.pk
